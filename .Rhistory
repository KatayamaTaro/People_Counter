# Step 2: plot
dow_boxplot <- ggplot(dayofweek_summary, aes(x = DayOfWeek, y = DailyVisitors, fill = DayOfWeek)) +
geom_jitter(aes(color = DayOfWeek), width = 0.2, alpha = 0.5, size = 0.7) +
geom_boxplot(outlier.shape = NA, alpha = 0.6, color = "black") +
scale_fill_manual(values = cal_palette(name = 'chaparral1', n = 7, type = 'continuous')) +
scale_color_manual(values = cal_palette(name = 'chaparral1', n = 7, type = 'continuous')) +
scale_y_continuous(labels = comma, breaks = pretty_breaks(n = 10)) +
facet_wrap(~ CounterID, nrow = 1) +
labs(x = "Day of week", y = "Visitors per day") +
theme_bw() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
panel.grid = element_blank(),
legend.position = "none"
)
dow_boxplot
ggsave(filename = './figures/boxplot.png',
width = 8, height = 5)
