View(trail_data)
ridgeline_data1 <- trail_data %>%
filter(is_mismatch == FALSE) %>%
filter(CounterID != "Tidepool Lot 2") %>%
filter(CounterID == c("Tidepool Lot 1", "Lighthouse"))%>%
mutate(Weekday = factor(Weekday, levels = c("Mon","Tue","Wed","Thu","Fri","Sat","Sun")))%>%
group_by(CounterID, Weekday, Hour) %>%
summarise(Visitors = mean(PedestrianCount, na.rm = TRUE), .groups = "drop")
ridgelineplot1 <- ggplot(data = ridgeline_data1) +
geom_ridgeline(mapping = aes(x = Hour, y = fct_rev(Weekday), height = Visitors/100,
fill = fct_rev(Weekday)), alpha = 0.4, linewidth = 0.2) +
scale_fill_manual(values = cal_palette(name = 'figmtn', n = 7, type = 'continuous')) +
scale_x_continuous(breaks = c(9,11, 13, 15,17, 19), limits = c(7,19)) +
geom_vline(xintercept = c(9,17), linetype = "dashed")+
xlab('Hour of day') +
ylab('Visitor activity') +
labs(fill = "Weekday")+
facet_wrap(~CounterID, nrow = 1)+
theme_bw()+
theme(panel.grid = element_blank())
ridgelineplot1
ggsave(filename = './figures/ridgelineplot1.png',
width = 6, height = 7,
dpi = 600)
ridgeline_data2 <- trail_data %>%
filter(is_mismatch == FALSE) %>%
filter(CounterID != "Tidepool Lot 2") %>%
filter(CounterID  == c("Bayside Trail", "Oceanside Trail 1"))%>%
mutate(Weekday = factor(Weekday, levels = c("Mon","Tue","Wed","Thu","Fri","Sat","Sun")))%>%
group_by(CounterID, Weekday, Hour) %>%
summarise(Visitors = mean(PedestrianCount, na.rm = TRUE), .groups = "drop")
ridgelineplot2 <- ggplot(data = ridgeline_data2) +
geom_ridgeline(mapping = aes(x = Hour, y = fct_rev(Weekday), height = Visitors/100,
fill = fct_rev(Weekday)), alpha = 0.6, linewidth = 0.2) +
scale_fill_manual(values = cal_palette(name = 'figmtn', n = 7, type = 'continuous')) +
scale_x_continuous(breaks = c(9,11, 13, 15,17, 19), limits = c(7,19)) +
geom_vline(xintercept = c(9,17), linetype = "dashed")+
xlab('Hour of day') +
ylab('Visitor activity') +
labs(fill = "Weekday")+
facet_wrap(~CounterID, nrow = 1)+
theme_bw()+
theme(panel.grid = element_blank())
ridgelineplot2
ggsave(filename = './figures/ridgelineplot2.png',
width = 6, height = 7,dpi = 600)
